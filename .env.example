# ================================================================
# .env.example — 실제 값은 절대 여기에 쓰지 말 것.
# 이 파일만 커밋한다. 실제 값은 `cp .env.example .env` 후 .env에 입력.
# .env 는 .gitignore 로 제외된다.
# ================================================================

# Slack Bot Token (xoxb- 로 시작하는 봇 토큰)
SLACK_BOT_TOKEN=xoxb-YOUR-BOT-TOKEN-HERE

# Slack Channel ID (C 로 시작하는 채널 ID, 채널명이 아님)
SLACK_CHANNEL_ID=C01234567890

# ── 저장소 백엔드 ────────────────────────────────────────────
# STORAGE_BACKEND: sqlite(로컬 기본) | supabase(클라우드)
STORAGE_BACKEND=sqlite
# supabase 사용 시 (봇 쓰기 — RLS 우회용 service_role 키):
#   Supabase → Project Settings → API 에서 Project URL 과 service_role 키 복사
SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
SUPABASE_SERVICE_KEY=your-service_role-key-here

# 바이낸스 선물 시세는 공개 API(인증 불필요)로 받는다.
# 아래 키는 (향후 실거래 모드용 — 현재 미사용. live 모드는 차단됨)
# BINANCE_API_KEY=your-api-key
# BINANCE_API_SECRET=your-api-secret
